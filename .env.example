# PostgreSQL connection
DATABASE_URL="postgresql://once:once@localhost:5432/once"

# 32+ random characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=""
HIDDEN_CODE_KEY=""   # encrypts hidden codes — never change after bottles exist

# Public URL of this app (used in emails and the general QR code)
APP_URL="http://localhost:3000"

# Email: "console" prints emails to the server log; "postmark" sends them
EMAIL_PROVIDER="console"
EMAIL_FROM="ONCE <hello@example.com>"
POSTMARK_TOKEN=""

# Where "Contact us" links point (the landing's contact section)
NEXT_PUBLIC_CONTACT_URL="/"

# First admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
